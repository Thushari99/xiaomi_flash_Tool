    <div class="relative z-10 max-w-3xl mx-auto">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4">How to Use Xiaomi Flash Tool </h1>
          <p class="text-xs sm:text-lg text-black">Follow our step-by-step guide to safely update your device's firmware.</p>
    </div>
</section>

  <!-- Prerequisites Section -->
 <section id="Prerequisites" class="py-12 md:py-20 px-4 section-fade-in">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-10 md:mb-16">
            <h2 class="text-2xl md:text-4xl font-bold text-darkGray mb-4">Before You Begin</h2>
          </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">

      <!-- Download Card -->
      <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-xl transition-shadow duration-300">
        <div class="text-orange text-3xl mb-4 text-center">
          <i class="fas fa-download"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-semibold mb-2 text-center text-darkGray">Latest Version</h3>
        <p class="text-sm sm:text-base text-mediumGray text-center">Download & install the latest</p>
      </div>

      <!-- USB Cable Card -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-shadow duration-300">
        <div class="text-orange text-3xl mb-4 text-center">
          <i class="fas fa-usb"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-semibold mb-2 text-center text-darkGray">USB Cable</h3>
        <p class="text-sm sm:text-base text-mediumGray text-center">Use a high-quality USB cable</p>
      </div>

      <!-- Battery Card -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-shadow duration-300">
        <div class="text-orange text-3xl mb-4 text-center">
          <i class="fas fa-battery-half"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-semibold mb-2 text-center text-darkGray">Battery Power</h3>
        <p class="text-sm sm:text-base text-mediumGray text-center">Ensure 50% battery charge</p>
      </div>

      <!-- Backup Card -->
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-shadow duration-300">
        <div class="text-orange text-3xl mb-4 text-center">
          <i class="fas fa-database"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-semibold mb-2 text-center text-darkGray">Backup Data</h3>
        <p class="text-sm sm:text-base text-mediumGray text-center">Backup important data first</p>
      </div>
    </div>
  </div>
</section>



 
  <!-- Installation Guide Mi Flash Tool-->
    <section id="getting-started" class="w-full py-10 md:py-20 bg-veryLightGray section-fade-in full-width-section">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-16">
       <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-darkGray mb-3 md:mb-4">How to install Mi Flash?</h2>
       <p class="text-base md:text-lg mt-3 md:mt-6 max-w-3xl mx-auto">In this comprehensive guide, we will walk you through the step-by-step process of installing Mi Flash on your Windows computer.</p>
       </div> 
            
        <div class="grid md:grid-cols-2 gap-6 md:gap-8">

          <!-- Step 1 -->
          <div class="bg-white rounded-xl p-5 md:p-6 shadow-md transform transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">1</div>
            <p class="text-sm md:text-base text-mediumGray mb-4 md:mb-0">Download and extract the latest installer version of Xiaomi Flash Tool on the Computer. If in case you have already downloaded and extracted the tool, then SKIP this step. After extracting the tool, you will be able to see the following files.</p>
            <div class="aspect-video rounded-lg overflow-hidden flex justify-center">
              <img src="/images/1.png" alt="Setup window" class="w-full h-full object-scale-down" >
            </div>
          </div>
          
          <!-- Step 2 -->
          <div class="bg-white rounded-xl p-5 md:p-6 shadow-md transform transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">2</div>
            <p class="text-sm md:text-base text-mediumGray mb-4 md:mb-6">Open MiPhone.exe (latest) and click on Next Button to Continue.</p>
            <div class="aspect-video rounded-lg overflow-hidden">
              <img src="/images/3.png" alt="Setup window" class="w-full h-full ">
            </div>
          </div>
          
          <!-- Step 3 -->
          <div class="bg-white rounded-xl p-5 md:p-6 shadow-md transform transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">3</div>
            <p class="text-sm md:text-base text-mediumGray mb-4 md:mb-6">Now, you will be able to see the Windows Security Dialog to install the Xiaomi Drivers. Click on Install this Driver Software Anyway to Continue.</p>
            <div class="aspect-video rounded-lg overflow-hidden">
              <img src="/images/2.png" alt="Security dialog" class="w-full h-full ">
            </div>
          </div>
          
          <!-- Step 4 -->
          <div class="bg-white rounded-xl p-5 md:p-6 shadow-md transform transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">4</div>
            <p class="text-sm md:text-base text-mediumGray mb-4 md:mb-6">Now, Xiaomi Flash Tool will be installed on the Computer Automatically.</p>
            <div class="aspect-video rounded-lg overflow-hidden">
              <img src="/images/4.png" alt="Installation complete" class="w-full h-full ">
            </div>
          </div>
        </div>

        <div class="text-center mt-8 md:mt-12">
          <p class="text-base md:text-lg text-mediumGray">Tip: Always back up your data before using any <b>phone flashing software.</b></p>
        </div>
      </div>
    </section>


 <!-- How to install Mi flash Pro -->
 <section id="getting-started" class="py-5 sm:py-5 md:py-5 px-4 sm:px-6 md:px-8 lg:px-12 bg-veryLightGray section-fade-in">
      <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
              <h2 class="text-2xl md:text-4xl font-bold text-darkGray mb-4">How to install Mi Flash Pro?</h2>
              <p class="text-lg mt-6 max-w-3xl mx-auto">In this comprehensive guide, we will walk you through the step-by-step process of installing Mi Flash Pro on your Windows computer.</p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-4">
              <!-- Step 1  -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">1</div>
                <p class="text-mediumGray mb-4">Download and extract the MiFlash Pro package. Once extracted, you'll see the following files.</p>
                <img src="/images/pro1.png" alt="Setup window" class="w-full h-48 object-cover rounded-lg mb-4">
            </div>
              
              
              <!-- Step 2  -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                  <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">2</div>
                  <p class="text-mediumGray mb-4">Double-click on MiFlash_Pro_Setup.exe to launch the setup window.</p>
                  <img src="/images/pro2.png" alt="Setup window" class="w-full h-48 object-cover rounded-lg mb-4">
              </div>
              
              <!-- Step 3  -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                  <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">3</div>
                  <p class="text-mediumGray mb-4">Click on the Next button.</p>
                  <img src="/images/pro3.png" alt="Next button" class="w-full h-45 object-cover rounded-lg mb-4">
              </div>
              
              <!-- Step 4 -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                  <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">4</div>
                  <p class="text-mediumGray mb-4">Click Install to begin the installation process.</p>
                  <img src="/images/pro4.png" alt="Install button" class="w-full h-45 object-cover rounded-lg mb-4">
              </div>
              
              <!-- Step 5  -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                  <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">5</div>
                  <p class="text-mediumGray mb-4">The installation may take a few seconds.</p>
                  <img src="/images/pro5.png" alt="Installation progress" class="w-full h-60 object-cover rounded-lg mb-4">
              </div>
              
              <!-- Step 6  -->
              <div class="bg-white rounded-xl p-6 shadow-md step-card">
                  <div class="w-12 h-12 bg-orange rounded-full flex items-center justify-center text-white font-bold text-xl mb-4">6</div>
                  <p class="text-mediumGray mb-4">Once complete, click Finish to close the setup window.</p>
                  <img src="/images/pro6.png" alt="Finish installation" class="w-full h-45 object-cover rounded-lg mb-4">
              </div>
          </div>
  
          <div class="text-center mt-12 fade-in-section">
              <p class="text-lg text-mediumGray mb-6">Tip: Always back up your data before using any <b>phone flashing software.</b></p>
          </div>
      </div>
  </section>



