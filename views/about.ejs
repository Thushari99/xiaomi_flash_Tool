<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800">
    <!-- About Us Hero -->
    <section class="bg-gray-100 min-h-[60vh] flex items-center justify-center text-orange-600 text-center relative py-28 px-4">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(139,10,10,0.1)_0%,transparent_70%)] pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl mx-auto">
            <h1 class="text-5xl font-bold mb-4">About DeviceFlash Pro</h1>
            <p class="text-xl text-black">Leading the way in firmware flashing technology since 2020</p>
        </div>
    </section>

    <!-- Our Story -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <div class="mb-12">
                <h2 class="text-4xl font-bold mb-2">Our Story</h2>
                <p class="text-gray-600">From a simple idea to the most trusted firmware flashing tool</p>
            </div>
            <div class="grid md:grid-cols-2 gap-10 items-center mt-10">
                <div class="text-left">
                    <p class="mb-6 text-lg leading-relaxed">DeviceFlash Pro started with a simple mission: to make firmware updates accessible and safe for everyone. What began as a small project has grown into a trusted solution used by millions worldwide.</p>
                    <p class="text-lg leading-relaxed">Our team of dedicated developers and engineers work tirelessly to ensure DeviceFlash Pro remains at the cutting edge of firmware flashing technology, supporting the latest devices and providing the most reliable experience possible.</p>
                </div>
                <div class="rounded-lg shadow-lg overflow-hidden">
                    <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="Team working" class="w-full h-auto">
                </div>
            </div>
        </div>
    </section>

    <!-- Our Values -->
    <section class="py-20 bg-gray-100">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <div class="mb-12">
                <h2 class="text-4xl font-bold mb-2">Our Values</h2>
                <p class="text-gray-600">The principles that guide everything we do</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white p-6 rounded-xl shadow text-center hover:-translate-y-1 transition-transform">
                    <div class="text-4xl text-orange-600 mb-4"><i class="fas fa-shield-alt"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Safety First</h3>
                    <p>We prioritize the safety of your devices with robust error checking and fail-safes.</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow text-center hover:-translate-y-1 transition-transform">
                    <div class="text-4xl text-orange-600 mb-4"><i class="fas fa-users"></i></div>
                    <h3 class="text-xl font-semibold mb-2">User-Focused</h3>
                    <p>Every feature and update is designed with our users' needs in mind.</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow text-center hover:-translate-y-1 transition-transform">
                    <div class="text-4xl text-orange-600 mb-4"><i class="fas fa-rocket"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Innovation</h3>
                    <p>We constantly push the boundaries of what's possible in firmware flashing.</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow text-center hover:-translate-y-1 transition-transform">
                    <div class="text-4xl text-orange-600 mb-4"><i class="fas fa-handshake"></i></div>
                    <h3 class="text-xl font-semibold mb-2">Reliability</h3>
                    <p>Our tools are thoroughly tested to ensure consistent performance.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <div class="mb-12">
                <h2 class="text-4xl font-bold mb-2">Meet Our Team</h2>
                <p class="text-gray-600">The people behind DeviceFlash Pro</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="text-center">
                    <div class="w-48 h-48 mx-auto mb-4 rounded-full overflow-hidden shadow">
                        <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Sarah Johnson" class="object-cover w-full h-full">
                    </div>
                    <h3 class="text-xl font-semibold">Sarah Johnson</h3>
                    <p class="text-orange-600 font-medium">Lead Developer</p>
                </div>
                <div class="text-center">
                    <div class="w-48 h-48 mx-auto mb-4 rounded-full overflow-hidden shadow">
                        <img src="https://images.pexels.com/photos/3785104/pexels-photo-3785104.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Michael Chen" class="object-cover w-full h-full">
                    </div>
                    <h3 class="text-xl font-semibold">Michael Chen</h3>
                    <p class="text-orange-600 font-medium">Security Expert</p>
                </div>
                <div class="text-center">
                    <div class="w-48 h-48 mx-auto mb-4 rounded-full overflow-hidden shadow">
                        <img src="https://images.pexels.com/photos/3760263/pexels-photo-3760263.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Emily Rodriguez" class="object-cover w-full h-full">
                    </div>
                    <h3 class="text-xl font-semibold">Emily Rodriguez</h3>
                    <p class="text-orange-600 font-medium">UX Designer</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Achievement Section -->
    <section class="py-20 bg-gray-100">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <div class="mb-12">
                <h2 class="text-4xl font-bold mb-2">Our Achievements</h2>
                <p class="text-gray-600">Milestones that mark our journey</p>
            </div>
            <div class="grid md:grid-cols-4 gap-6">
                <div class="bg-white p-6 rounded-xl shadow">
                    <div class="text-4xl font-bold text-orange-600 mb-2">1M+</div>
                    <p>Active Users</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow">
                    <div class="text-4xl font-bold text-orange-600 mb-2">500+</div>
                    <p>Supported Devices</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow">
                    <div class="text-4xl font-bold text-orange-600 mb-2">99.9%</div>
                    <p>Success Rate</p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow">
                    <div class="text-4xl font-bold text-orange-600 mb-2">24/7</div>
                    <p>Support Available</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-20 bg-white text-center">
        <div class="max-w-xl mx-auto px-4">
            <h2 class="text-3xl font-bold mb-4">Want to Learn More?</h2>
            <p class="text-gray-700 mb-6">Get in touch with our team to learn more about DeviceFlash Pro</p>
            <a href="/contact" class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg hover:bg-orange-700 transition">Contact Us</a>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>