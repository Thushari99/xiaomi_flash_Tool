<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footer Example</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom Styles -->
   
</head>
<body class="min-h-screen flex flex-col">
    <main class="flex-grow">
        <!-- Your main content here -->
    </main>

    <footer class="bg-gray-900 text-white">
        <div class="max-w-7xl mx-auto px-4 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <!-- Brand Info -->
                <div>
                    <div class="flex items-center space-x-3 mb-4">
                        <img src="/images/xioami_logo.png" alt="Xiaomi Flash Tool Logo" class="h-8 w-auto rounded">
                        <span class="text-xl font-semibold">Xiaomi Flash Tool</span>
                    </div>
                    <p class="text-sm text-gray-400">
                        The most reliable flashing tool for Xiaomi devices. Developed by experienced community contributors.
                    </p>
                </div>
                
                <!-- Quick Links -->
                <div>
                    <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-orange-400 transition-colors duration-300">Home</a></li>
                        <li><a href="#" class="hover:text-orange-400 transition-colors duration-300">Download</a></li>
                        <li><a href="#" class="hover:text-orange-400 transition-colors duration-300">Tutorials</a></li>
                        <li><a href="#" class="hover:text-orange-400 transition-colors duration-300">FAQ</a></li>
                        <li><a href="#" class="hover:text-orange-400 transition-colors duration-300">Contact Us</a></li>
                    </ul>
                </div>
                
                <!-- Community -->
                <div class="flex flex-col items-start md:items">
                    <h4 class="text-lg font-semibold mb-4">Community</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="social-icon">
                            <i class="fab fa-facebook-f text-lg"></i>
                        </a>
                        <a href="#" class="social-icon">
                            <i class="fab fa-twitter text-lg"></i>
                        </a>
                        <a href="#" class="social-icon">
                            <i class="fab fa-telegram text-lg"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-10 border-t border-gray-700 pt-6 text-center text-sm text-gray-500">
                &copy;  Xiaomi Flash Tool. All rights reserved.
            </div>
        </div>
    </footer>
</body>



  